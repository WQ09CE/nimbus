# Template only. Not installed/enabled by the implementation session.
[Unit]
Description=Nimbus private Telegram gateway/control
After=network-online.target nimbus-chat-postgres.service
Wants=network-online.target nimbus-chat-postgres.service

[Service]
WorkingDirectory=%h/Projects/nimbus-telegram/chat-lab
EnvironmentFile=%h/.config/nimbus-chat-lab/gateway.env
ExecStart=%h/Projects/nimbus-telegram/chat-lab/.venv/bin/nimbus-chat-lab gateway --bot ${NIMBUS_BOT_ID} --drafts
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=default.target
